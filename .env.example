# Vistructum Beispiel-Konfiguration (nach .env kopieren, .env bleibt lokal)
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8000
MODEL_DIR=/models
ORT_THREADS=1
# /captures speichert jede Sidecar-Anfrage unter ./captures (echte Gelände- und Fehlalarm-Daten); leer = aus
CAPTURE_DIR=
CAPTURE_MAX=20000
OUTBOX_PATH=plugins/vistructum/outbox.db
POLL_INTERVAL_SECONDS=2
